# Runtime arguments used by scripts/run_live_vps.sh.
BOT_PAIRS=B-ZEC_USDT
BOT_CAPITAL_PER_PAIR=2500
BOT_LEVERAGE=5
BOT_INTERVAL=5m
BOT_EXECUTION_INTERVAL=1m
BOT_STRATEGY=hybrid_meta_v2

# Optional values. Leave empty to omit the corresponding CLI option.
BOT_LEVERAGE_BY_PAIR=
BOT_TAKE_PROFIT_PCT=
BOT_DRY_RUN=false

# Durable application logs. These values override .env for this service only.
LOG_LEVEL=INFO
LOG_DIR=/var/log/coindcx-bot
LOG_MAX_BYTES=25000000
LOG_BACKUP_COUNT=30
LOG_COMPRESS_BACKUPS=true
