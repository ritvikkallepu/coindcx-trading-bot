# CoinDCX credentials
# Keep this file as a template. Put real values in a local .env file only.
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Exchange URLs
COINDCX_API_BASE_URL=https://api.coindcx.com
COINDCX_PUBLIC_BASE_URL=https://public.coindcx.com
COINDCX_WS_URL=wss://stream.coindcx.com

# Trading defaults
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
# STERN WARNING: REAL LIVE TRADING IS BLOCKED UNLESS THIS IS SET TO YES
LIVE_CONFIRM_I_UNDERSTAND_RISK=NO
# Keep live pilot dry-run on until manually testing with tiny capital.
LIVE_PILOT_DRY_RUN=true
# Live risk approval remains off unless you intentionally enable the pilot gate.
LIVE_RISK_APPROVAL_ENABLED=false

# Live absolute caps (INR)
LIVE_MAX_ORDER_NOTIONAL=1000
LIVE_MAX_MARGIN_PER_ORDER=500
LIVE_MAX_DAILY_LOSS_INR=1000
LIVE_MAX_ORDERS_PER_DAY=3
# Minimum confidence required for live entries
LIVE_MIN_CONFIDENCE=0.60

# Live loop controls
LIVE_REST_POLL_SECONDS=10
LIVE_RECONCILE_SECONDS=30
LIVE_ALLOWED_PAIRS=B-BTC_USDT
LIVE_ALLOWED_STRATEGIES=hybrid_meta_v2,rsi_macd_momentum

# Live safety guards
LIVE_REQUIRE_STOP_LOSS=true
LIVE_REQUIRE_EXCHANGE_STOP_SYNC=true
# INR-M futures should use isolated margin for the pilot.
LIVE_POSITION_MARGIN_TYPE=isolated
# Kill switch: blocks new entries and optionally flattens existing ones
LIVE_KILL_SWITCH=false
LIVE_CLOSE_ON_KILL_SWITCH=false
LIVE_CANCEL_ORDERS_ON_KILL_SWITCH=true

# Market Data
FUTURES_MARGIN_CURRENCY=INR
DEFAULT_PAIR=B-BTC_USDT
# Default paper account starting equity in INR.
PAPER_STARTING_EQUITY=100000
PAPER_STARTING_EQUITY_CURRENCY=INR

# REST client controls
HTTP_TIMEOUT_SECONDS=15
API_MAX_RETRIES=3
API_RETRY_BASE_DELAY_SECONDS=0.5
API_RATE_LIMIT_PER_SECOND=4
HTTP_USER_AGENT=CoinDCXFuturesBot/0.1
WS_PING_INTERVAL_SECONDS=25

# Risk defaults
MAX_RISK_PER_TRADE_PCT=5
MAX_DAILY_LOSS_PCT=10
MAX_OPEN_POSITIONS=1
MAX_LEVERAGE=30
TRAILING_STOP_ENABLED=false
TRAILING_STOP_ACTIVATION_PCT=1
TRAILING_STOP_DISTANCE_PCT=2

# Profit Isolation (Virtual Accounting)
PROFIT_LOCK_ENABLED=true
PROFIT_LOCK_ACTIVATION_R=1.2
PROFIT_LOCK_R=0.25

# ATR dynamic exit defaults used by paper/backtest.
ATR_STOP_ENABLED=true
ATR_TAKE_PROFIT_ENABLED=true
ATR_TRAILING_ENABLED=true
ATR_TAKE_PROFIT_MODE=fixed
ATR_STOP_MULTIPLE=1.5
ATR_TAKE_PROFIT_MULTIPLE=2.4
# Keep this tighter than ATR_STOP_MULTIPLE so the trail can improve sooner.
ATR_TRAILING_MULTIPLE=1.2

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
