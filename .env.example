# CoinDCX credentials
# Keep this file as a template. Put real values in a local .env file only.
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Exchange URLs
COINDCX_API_BASE_URL=https://api.coindcx.com
COINDCX_PUBLIC_BASE_URL=https://public.coindcx.com
COINDCX_WS_URL=wss://stream.coindcx.com

# Trading defaults
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
# INR-M futures use INR as margin/settlement while market prices may still display in USDT.
FUTURES_MARGIN_CURRENCY=INR
DEFAULT_PAIR=B-BTC_USDT
# Default paper account starting equity in INR.
PAPER_STARTING_EQUITY=100000
PAPER_STARTING_EQUITY_CURRENCY=INR

# REST client controls
HTTP_TIMEOUT_SECONDS=15
API_MAX_RETRIES=3
API_RETRY_BASE_DELAY_SECONDS=0.5
API_RATE_LIMIT_PER_SECOND=4
HTTP_USER_AGENT=CoinDCXFuturesBot/0.1
WS_PING_INTERVAL_SECONDS=25

# Risk defaults
MAX_RISK_PER_TRADE_PCT=5
MAX_DAILY_LOSS_PCT=10
MAX_OPEN_POSITIONS=1
MAX_LEVERAGE=30
TRAILING_STOP_ENABLED=false
TRAILING_STOP_ACTIVATION_PCT=1
TRAILING_STOP_DISTANCE_PCT=2

# Bollinger Band hybrid trail is disabled by default; enable only for paper validation.
BB_TRAIL_ENABLED=false
# ATR buffer around the Bollinger middle band.
BB_TRAIL_BUFFER_MULTIPLIER=1.0
# R profit required before BB trail can activate.
BB_TRAIL_ACTIVATION_R=0.5
# R threshold for stage 2 BB trailing.
BB_TRAIL_STAGE2_R=0.5
# R threshold for stage 3 aggressive BB trailing.
BB_TRAIL_STAGE3_R=1.0
# R ceiling that marks the trade for a BB trail force close.
BB_TRAIL_FORCE_CLOSE_R=4.0
# Close part of the position at original TP and trail the rest.
BB_TRAIL_PARTIAL_CLOSE_AT_TP=true
# Fraction closed at original TP when BB trail partial mode is active.
BB_TRAIL_PARTIAL_CLOSE_PCT=0.60

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
