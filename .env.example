# CoinDCX credentials
# Keep this file as a template. Put real values in a local .env file only.
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Exchange URLs
COINDCX_API_BASE_URL=https://api.coindcx.com
COINDCX_PUBLIC_BASE_URL=https://public.coindcx.com
COINDCX_WS_URL=wss://stream.coindcx.com

# Trading defaults
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
# STERN WARNING: REAL LIVE TRADING IS BLOCKED UNLESS THIS IS SET TO YES
LIVE_CONFIRM_I_UNDERSTAND_RISK=NO
# Keep live pilot dry-run on until manually testing with tiny capital.
LIVE_PILOT_DRY_RUN=true

# MUST be explicitly set to true during the live pilot, AFTER setting notional and margin caps below.
LIVE_RISK_APPROVAL_ENABLED=false

# Live absolute caps (INR)
LIVE_MAX_ORDER_NOTIONAL=5000
LIVE_MAX_MARGIN_PER_ORDER=1000
LIVE_MAX_DAILY_LOSS_INR=1000
LIVE_MAX_ORDERS_PER_DAY=99999
# Minimum confidence required for live entries
LIVE_MIN_CONFIDENCE=0.58

# Live loop controls
LIVE_REST_POLL_SECONDS=10
LIVE_RECONCILE_SECONDS=30
# Wait this long after a candle boundary before allowing an entry.
LIVE_CLOSED_CANDLE_BUFFER_MS=2000
LIVE_ALLOWED_PAIRS=B-BTC_USDT
LIVE_ALLOWED_STRATEGIES=hybrid_meta_v2,rsi_macd_momentum

# Live safety guards
LIVE_REQUIRE_STOP_LOSS=true
LIVE_REQUIRE_EXCHANGE_STOP_SYNC=true
# INR-M futures should use isolated margin for the pilot.
LIVE_POSITION_MARGIN_TYPE=isolated

# Kill switch: blocks new entries and optionally flattens existing ones
LIVE_KILL_SWITCH=false
# WARNING: If LIVE_CLOSE_ON_KILL_SWITCH=false, open positions will NOT be closed automatically if a kill switch event occurs.
# Recommended to set to true unless you want to manage open positions manually after a kill switch.
LIVE_CLOSE_ON_KILL_SWITCH=false
LIVE_CANCEL_ORDERS_ON_KILL_SWITCH=true

# Market Data
FUTURES_MARGIN_CURRENCY=INR
DEFAULT_PAIR=B-BTC_USDT
# Default paper account starting equity in INR.
PAPER_STARTING_EQUITY=100000
PAPER_STARTING_EQUITY_CURRENCY=INR
# USDT to INR conversion rate for margin calculations.
QUOTE_TO_MARGIN_RATE=102

# REST client controls
HTTP_TIMEOUT_SECONDS=15
API_MAX_RETRIES=3
API_RETRY_BASE_DELAY_SECONDS=0.5
API_RATE_LIMIT_PER_SECOND=4
HTTP_USER_AGENT=CoinDCXFuturesBot/0.1
WS_PING_INTERVAL_SECONDS=25

# Risk defaults
MAX_RISK_PER_TRADE_PCT=25
MAX_TOTAL_RISK_PCT=50
MAX_DAILY_LOSS_PCT=10
MAX_OPEN_POSITIONS=2
MAX_LEVERAGE=125
# Keep true unless CoinDCX confirms its futures instrument leverage metadata is stale.
ENFORCE_EXCHANGE_LEVERAGE_LIMIT=true
# Optional per-pair required-margin cap in INR; 0 disables the pair bucket.
MAX_MARGIN_PER_PAIR=0
MIN_STOP_DISTANCE_PCT=0.5
TRAILING_STOP_ENABLED=true
TRAILING_STOP_ACTIVATION_PCT=1
TRAILING_STOP_DISTANCE_PCT=2

# Optional legacy short-only filters. Keep disabled for symmetric entries.
SHORT_STRICTNESS_ENABLED=false
SHORT_CONFIDENCE_BONUS=0
SHORT_MIN_AGREEMENT_BONUS=0
SHORT_REQUIRE_TREND_CONFIRMATION=true
SHORT_REQUIRE_PRICE_BELOW_EMA=true
SHORT_REQUIRE_BEARISH_STRUCTURE=false
SHORT_REQUIRE_VOLUME_CONFIRMATION=false

# Profit Isolation (Virtual Accounting)
PROFIT_LOCK_ENABLED=false
COMPOUND_PROFITS=true
PROFIT_LOCK_ACTIVATION_R=1.2
PROFIT_LOCK_R=0.25

# Protect a fraction of the best R seen so large winners do not fade to tiny wins.
PROFIT_GIVEBACK_GUARD_ENABLED=true
PROFIT_GIVEBACK_ACTIVATION_R=1.0
PROFIT_GIVEBACK_LOCK_FRACTION=0.50
PROFIT_GIVEBACK_MIN_LOCK_R=0.25
PROFIT_GIVEBACK_TIGHTEN_AFTER_R=3.0
PROFIT_GIVEBACK_TIGHTEN_FRACTION=0.70
POST_PROFIT_REENTRY_GUARD_ENABLED=true
POST_PROFIT_REENTRY_COOLDOWN_CANDLES=12
POST_PROFIT_REENTRY_PULLBACK_ATR=0.75
POST_PROFIT_REENTRY_PULLBACK_PCT=1.0

# ATR dynamic exit defaults used by paper/backtest.
ATR_STOP_ENABLED=false
ATR_TAKE_PROFIT_ENABLED=false
ATR_TRAILING_ENABLED=true
ATR_TAKE_PROFIT_MODE=fixed
ATR_STOP_MULTIPLE=1.5
ATR_TAKE_PROFIT_MULTIPLE=2.4
# Keep this tighter than ATR_STOP_MULTIPLE so the trail can improve sooner.
ATR_TRAILING_MULTIPLE=1.2

# Bollinger Band hybrid trail
BB_TRAIL_ENABLED=false
BB_TRAIL_BUFFER_MULTIPLIER=1.0
BB_TRAIL_ACTIVATION_R=0.5
BB_TRAIL_STAGE2_R=0.5
BB_TRAIL_STAGE3_R=1.0
BB_TRAIL_FORCE_CLOSE_R=4.0
BB_TRAIL_PARTIAL_CLOSE_AT_TP=true
BB_TRAIL_PARTIAL_CLOSE_PCT=0.60
# true = BB trail runs for dashboard visibility only; exits use ATR stop-loss only.
# false = BB trail stop actively controls the exit price and can fire force-close and partial closes.
BB_TRAIL_OBSERVE_ONLY=true

# Entry Timing and Quality
BALANCED_BREAKOUT_ENABLED=true
BALANCED_BREAKOUT_VOLUME_RATIO_MIN=1.8
FALSE_BREAKOUT_FILTER_ENABLED=true

# Late Chase Block (Prevents entering after a massive move)
LATE_CHASE_BLOCK_ENABLED=true
LATE_CHASE_MAX_CONSECUTIVE_IMPULSE_CANDLES=3
LATE_CHASE_VOLUME_FADE_RATIO=0.75
LATE_CHASE_MAX_EXTENSION_ATR=2.2

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
# Rotate at 25 MB and retain 30 compressed files (about 750 MB before compression).
LOG_MAX_BYTES=25000000
LOG_BACKUP_COUNT=30
LOG_COMPRESS_BACKUPS=true
